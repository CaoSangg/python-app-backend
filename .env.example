# Copy to .env and choose separate passwords for the two local databases.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_app_password
POSTGRES_DB=songs_db
DATABASE_URL=postgresql+asyncpg://postgres:change_me_app_password@db:5432/songs_db
APP_HOST_PORT=8004

# Only needed for the test profile. Keep the test role and database shown here.
POSTGRES_TEST_PASSWORD=change_me_test_password
TEST_DATABASE_URL=postgresql+asyncpg://songs_test_runner:change_me_test_password@db_test:5432/songs_test_db
