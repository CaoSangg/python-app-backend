# =============================================================
# Song Management API – Environment Variables Template
# USAGE: cp .env.example .env  rồi sửa giá trị thực tế
# CẢNH BÁO: Không bao giờ commit file .env lên Git!
# =============================================================

# ----- PostgreSQL (Application Database) -----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=songs_db
POSTGRES_PORT=5432

# ----- PostgreSQL (Test Database - Isolated) -----
POSTGRES_TEST_DB=songs_test_db

# ----- FastAPI Application Database URL -----
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB>
DATABASE_URL=postgresql+asyncpg://postgres:changeme_strong_password@db:5432/songs_db

# ----- Integration Test Database URL (Points to db_test service) -----
TEST_DATABASE_URL=postgresql+asyncpg://postgres:changeme_strong_password@db_test:5432/songs_test_db

# ----- App Server -----
APP_PORT=8000
APP_HOST=0.0.0.0

# ----- Debug / Development -----
ECHO_SQL=1
